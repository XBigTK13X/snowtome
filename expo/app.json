{
  "expo": {
    "name": "snowtome",
    "slug": "snowtome",
    "scheme": "com.simplepathstudios.snowtome",
    "newArchEnabled": true,
    "icon": "./assets/icon/appicon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#2cdb72",
          "android": {
            "image": "./assets/icon/splash.png",
            "resizeMode": "contain",
            "backgroundColor": "#2cdb72"
          }
        }
      ],
      [
        "@react-native-tvos/config-tv",
        {
          "androidTVBanner": "./assets/icon/android/tvbanner.png"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {}
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://bugsink.9914.us",
          "project": "snowtome",
          "organization": "Arctic"
        }
      ],
      "expo-secure-store"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/appicon.png",
        "backgroundColor": "#2cdb72"
      },
      "package": "com.simplepathstudios.snowtome",
      "backgroundColor": "#000000",
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "com.simplepathstudios.snowtome"
    }
  }
}